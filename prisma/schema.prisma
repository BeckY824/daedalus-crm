// CRM 客户管理系统 — 数据模型
// SQLite 用于本地开发；切换 PostgreSQL 只需改 provider 与 DATABASE_URL。
// SQLite 不支持 enum，所有枚举以 String 存储，取值常量见 src/lib/constants.ts

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  output        = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  title     String   @default("销售")
  role      String   @default("SALES") // ADMIN | MANAGER | SALES
  avatar    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads            Lead[]
  /// 作为销售负责人跟进的学员
  salesCustomers   Customer[]    @relation("SalesOwner")
  /// 作为渠道负责人吸纳的学员
  channelCustomers Customer[]    @relation("CustomerChannelOwner")
  /// 负责的外部渠道
  channels         Channel[]     @relation("ChannelOwner")
  opportunities    Opportunity[]
  followUps        FollowUp[]
  tasks            Task[]
  plans            FollowPlan[]
}

/// 托管版：控制面账号 ↔ 本工作区用户。自部署版为空表。
/// 不与 User 建外键：成员被删时这条映射由应用清理，外键会让删人这件事跨库耦合
model WorkspaceAccount {
  userId    String @id
  accountId String

  @@index([accountId])
}

model Lead {
  id          String    @id @default(cuid())
  name        String // 线索名称 / 公司名
  contact     String? // 联系人姓名
  phone       String?
  email       String?
  industry    String?
  source      String    @default("其他") // 能选也能填；候选见 lib/constants.ts 的 CUSTOMER_SOURCES（微信 / 小红书 / 抖音 / 转介绍 / 官网注册 …）
  status      String    @default("待跟进") // 待跟进 | 跟进中 | 已转化 | 已放弃
  remark      String?
  ownerId     String?
  owner       User?     @relation(fields: [ownerId], references: [id])
  convertedAt DateTime?
  customerId  String?   @unique
  customer    Customer? @relation(fields: [customerId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([ownerId])
}

/// 外部推荐渠道（如老师、中介、合作方）。链条最顶端的推荐来源。
model Channel {
  id             String  @id @default(cuid())
  name           String  @unique /// 渠道姓名，如「小红」
  phone          String?
  remark         String?
  /// 渠道负责人：内部员工，负责吸纳该渠道带来的所有客户，整条推荐链永久继承
  channelOwnerId String
  channelOwner   User    @relation("ChannelOwner", fields: [channelOwnerId], references: [id])
  active         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 由该渠道直接推荐的学员
  directCustomers Customer[] @relation("CustomerChannel")
  /// 渠道归属计算落到该渠道的学员（往上两代命中）
  attributed      Customer[] @relation("CustomerAttributionChannel")

  @@index([channelOwnerId])
}

/// 学员（潜在或已签约）
model Customer {
  id     String  @id @default(cuid())
  name   String /// 客户姓名
  phone  String /// 联系电话，查重主键
  school String? /// 院校
  grade  String? /// 年级
  major  String? /// 专业

  /// ---------- 推荐关系 ----------
  /// 链条最顶端的外部渠道。所有后代继承，用于确定渠道负责人
  channelId String?
  channel   Channel? @relation("CustomerChannel", fields: [channelId], references: [id])

  /// 直接推荐人是已有学员时指向该学员；为空且 channelId 有值表示由渠道直接推荐
  referrerCustomerId String?
  referrerCustomer   Customer?  @relation("Referral", fields: [referrerCustomerId], references: [id])
  referrals          Customer[] @relation("Referral")

  /// ---------- 渠道归属：推荐链往上第二代，不足两代取链条顶端 ----------
  /// 命中外部渠道时用这个
  attributionChannelId  String?
  attributionChannel    Channel?   @relation("CustomerAttributionChannel", fields: [attributionChannelId], references: [id])
  /// 命中已有学员时用这个
  attributionCustomerId String?
  attributionCustomer   Customer?  @relation("Attribution", fields: [attributionCustomerId], references: [id])
  attributedCustomers   Customer[] @relation("Attribution")

  /// ---------- 负责人 ----------
  /// 销售负责人：负责谈单签约
  salesOwnerId   String
  salesOwner     User    @relation("SalesOwner", fields: [salesOwnerId], references: [id])
  /// 渠道负责人：继承自 channel.channelOwner，冗余存储便于筛选统计
  channelOwnerId String?
  channelOwner   User?   @relation("CustomerChannelOwner", fields: [channelOwnerId], references: [id])

  /// ---------- 跟进与决策 ----------
  followStatus   String    @default("待跟进") /// 跟进状态
  decisionStatus String    @default("了解中") /// 客户决策状态
  expectedSignAt DateTime? /// 预计签约时间
  expectedSignOn String? /// 原日历日；旧记录未知为空
  lastFollowAt   DateTime? /// 最近跟进
  remark         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts      Contact[]
  followUps     FollowUp[]
  tasks         Task[]
  plans         FollowPlan[]
  opportunities Opportunity[]
  contracts     Contract[]
  /// 外贸订单（2026-10-03）。见 TradeOrder
  tradeOrders   TradeOrder[]
  /// 在公海里（2026-10-03 第 6 块）。见 CustomerPool
  pool          CustomerPool?
  /// 最近一次从公海领走（第 6 块复查）。见 CustomerClaim
  claim         CustomerClaim?
  /// 外贸档案：国家、WhatsApp、微信、邮箱、来源（2026-10-05）。见 CustomerExtra
  extra         CustomerExtra?
  lead          Lead?
  /// 团队版项目模式（2026-10-23，1a）。见 Project、CustomerCreator
  projects      Project[]
  creator       CustomerCreator?
  ownerLogs     CustomerOwnerLog[]
  /// 企业版联系方式子表（migrations/054）。见 ContactMethod
  contactMethods ContactMethod[]

  @@index([phone])
  @@index([salesOwnerId])
  @@index([channelOwnerId])
  @@index([channelId])
  @@index([referrerCustomerId])
  /// 删客户时按外键找「归属指向他」的客户要用（迁移 024，2026-10-06 大库实测：没有它撤销 1 万行导入要 2 分钟）
  @@index([attributionCustomerId])
  @@index([followStatus])
  @@index([decisionStatus])
  /// 客户列表默认按建档时间倒序翻页（迁移 049）：10 万客户时没有它每页都要全表排序一遍
  @@index([createdAt, id])
}

/// 签约记录。同一学员可多次签约（续费、补课），便于按月/季/年复盘
model Contract {
  id         String         @id @default(cuid())
  customerId String
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount     Int /// 签约金额，单位：元
  signedAt   DateTime /// 签约时间
  remark     String?
  /// 签约那一刻是谁的单（排查 B2）。见 ContractOwner
  owner      ContractOwner?
  /// 币种和精确金额（2026-10-03）。见 ContractMoney
  money      ContractMoney?
  /// 登记时顺手标成赢单的商机（2026-10-04 L-007）。见 ContractWin
  wins       ContractWin[]
  /// 外贸模版下这笔签约就是一张订单（2026-10-05）。见 TradeOrder.contractId
  order      TradeOrder?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([signedAt])
}

/// 签约的币种与精确金额（2026-10-03 全站币种，迁移 014）。
/// 单独一张表、不给 Contract 加列：同 ContractOwner——Contract 只由 schema 建，迁移在空库上从头跑，加列会报表不存在。
/// Contract.amount 是 Int（元），美元的美分存不下：amountExact 存精确值，读的时候有它用它、没有退回 amount（见 lib/money-db.ts）。
/// 老签约没有这一行：人民币、按 amount。
model ContractMoney {
  contractId  String   @id
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  currency    String   @default("CNY")
  amountExact Float?
}

/// 签约那一刻的销售负责人 / 渠道负责人（2026-10-02 排查 B2，迁移 011）。
/// 业绩按它算：之后换负责人、停用同事，都不再把历史业绩搬到接手的人头上（09 月拍板「谁的数据没动，谁的归属就不变」）。
/// 单独一张表、不给 Contract 加列：Contract 是全新安装时由 schema 建的表，迁移只能加表（tests/migrations.test.ts 在空库上从头跑）。
/// 负责人不连外键：停用的人不删，名字照样查得到。0.46.15 之前的老签约没有这一行，报表退回按客户现在的负责人算。
model ContractOwner {
  contractId     String   @id
  contract       Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  salesOwnerId   String?
  channelOwnerId String?
}

model Contact {
  id         String   @id @default(cuid())
  name       String
  position   String? // 与学员的关系：母亲 / 父亲 / 学生本人 …
  phone      String?
  email      String?
  wechat     String?
  isPrimary  Boolean  @default(false) // 关键联系人
  remark     String?
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  followUps FollowUp[]
  /// 作为主联系人的项目（2026-10-23 项目模式 1a）
  projects  Project[]
  /// 企业版联系方式子表里挂在这位身上的号（migrations/054）
  contactMethods ContactMethod[]

  @@index([customerId])
}

/// 从客户上移出、人留着的联系人（2026-10-01 用户反馈：在客户详情里删联系人，联系人页里也跟着没了）。
/// 单独一张表，不留在 Contact 里加个标记：Contact.customerId 不能为空、删客户会级联删联系人，
/// 留在那儿早晚被原来那位客户一起带走。id 沿用原来那条 Contact 的，挂回去时原样搬回。
model UnassignedContact {
  id               String   @id
  name             String
  position         String?
  phone            String?
  email            String?
  wechat           String?
  remark           String?
  ownerId          String? // 移出/保留联系人时的操作者；不连外键，原客户删除后仍保留归属
  fromCustomerId   String? // 原来是谁的。不连外键：那位之后可能被删了
  fromCustomerName String? // 原来那位的名字，给人看
  wasPrimary       Boolean? // 移出时是否关键；老数据未记录则为空，不推测
  followUpIds      String? // 原来指着他的跟进记录 id（JSON 数组）。挂回原来那位时接回去
  detachedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([ownerId])
}

model Opportunity {
  id             String    @id @default(cuid())
  name           String
  amount         Float     @default(0)
  stage          String    @default("初步沟通") // 初步沟通|需求确认|方案报价|谈判审核|赢单成交
  status         String    @default("OPEN") // OPEN | WON | LOST
  probability    Int       @default(10)
  expectedDealAt DateTime?
  remark         String?
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ownerId        String
  owner          User      @relation(fields: [ownerId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  /// 最近业务推进；转交负责人不算推进。老数据为空时沿用原修改时间。
  activityAt     DateTime?

  followUps      FollowUp[]
  /// 赢单 / 丢单的那一刻（排查 C6）。见 OpportunityClose
  closed         OpportunityClose?
  /// 币种（2026-10-03）。见 OpportunityMoney
  money          OpportunityMoney?
  /// 报价明细，一次报价一行（2026-10-03）。见 Quote
  quotes         Quote[]
  /// 赢单后生成的订单（2026-10-03）。见 TradeOrder
  tradeOrders    TradeOrder[]
  /// 供应商比价（2026-10-03）。见 SupplierQuote
  supplierQuotes SupplierQuote[]
  /// 是哪笔签约顺手赢下来的（2026-10-04 L-007）。见 ContractWin
  contractWin    ContractWin?

  @@index([customerId])
  @@index([stage])
}

/// 商机赢单 / 丢单的那一刻（2026-10-02 排查 C6，迁移 012）。重新打开就删掉这一行。
/// 原来「本月赢单」拿 updatedAt 近似：老的赢单改一下备注，就被算进本月。
/// 单独一张表、不给 Opportunity 加列：理由同 ContractOwner（Opportunity 是 schema 建的表，迁移只能加表）。
/// 0.46.15 之前结单的没有这一行，看板退回按 updatedAt。
model OpportunityClose {
  opportunityId String      @id
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  closedAt      DateTime    @default(now())
}

/// 登记签约时顺手标成赢单的商机，和它赢单之前的阶段 / 概率（2026-10-04 L-007，迁移 020）。
/// 原来签约和赢单之间什么都不留：删了签约，商机一直挂着赢单，本月赢单 / 漏斗 / 业绩一起虚高。
/// 删这笔签约时据此退回去；商机之后离开过赢单（人改成丢单、拖回别的阶段）就删掉这一行——人动过的不再替人退。
/// 一个商机只会被一笔签约赢下（登记时只列得出进行中的商机），所以按商机做主键：团队同步要求单列主键。
/// 单独一张表，理由同 OpportunityClose。
model ContractWin {
  opportunityId   String      @id
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  contractId      String
  contract        Contract    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  prevStage       String
  prevProbability Int

  @@index([contractId])
}

/// 商机的币种（2026-10-03 全站币种，迁移 013）。单独一张表，理由同 OpportunityClose。没有这一行 = 人民币。
model OpportunityMoney {
  opportunityId String      @id
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  currency      String      @default("CNY")
}

/// 一次报价（2026-10-03 外贸第 3 块，迁移 015）。改价不覆盖，另记一版：同一个商机的几行 Quote 就是「历次报价」，
/// 最新那一版是当前报价。币种是报价那一刻商机的币种。单独建表的理由同 OpportunityMoney。
model Quote {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  quotedAt      DateTime    @default(now())
  currency      String      @default("CNY")
  lines         QuoteLine[]

  @@index([opportunityId])
}

/// 报价的一行：产品 / 规格（自由文本，不强制建产品库）、数量、单位、单价。小计 = 数量 × 单价，不存
model QuoteLine {
  id        String  @id @default(cuid())
  quoteId   String
  quote     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  sort      Int     @default(0)
  product   String
  spec      String?
  qty       Float   @default(0)
  unit      String?
  unitPrice Float   @default(0)

  @@index([quoteId])
}

/// 外贸订单（2026-10-03 外贸第 3a 块，迁移 016）。商机管成交前（询盘 → 报价 → 客户确认），订单管成交后：
/// 12 个节点（TradeOrderNode）各有截止日 + 状态，单据清单（TradeOrderDoc），定金 / 尾款的应收实收。
/// 只在外贸模版下出现入口。业务员下单那一刻固化（ownerId，不建外键，同 ContractOwner）。
/// 表名不叫 Order：SQL 关键字。尾款应收 = amount - depositDue，不另存。
model TradeOrder {
  id            String       @id @default(cuid())
  /// 订单号 / PI 号，人能改；新建默认「年月日-序号」
  no            String
  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  ownerId       String
  amount        Float        @default(0)
  currency      String       @default("USD")
  /// 贸易条款：EXW / FOB / CFR / CIF / FCA / DAP / DDP
  incoterm      String?
  /// 付款方式：T/T 30/70、L/C at sight……自由文本
  payment       String?
  depositDue    Float        @default(0)
  depositPaid   Float        @default(0)
  depositAt     DateTime?
  balancePaid   Float        @default(0)
  balanceAt     DateTime?
  remark        String?
  /// 这张订单就是哪一笔签约（2026-10-05，迁移 023）：外贸模版下「新建订单」同时登记一笔签约，
  /// 金额、币种、确认时间（= 签约时间）以签约为准，业绩、首页、数据页都照签约算。签约删了订单跟着没。
  /// 空 = 0.46.15 时从商机直接生成的老订单，没有对应的签约
  contractId    String?      @unique
  contract      Contract?    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt

  nodes     TradeOrderNode[]
  docs      TradeOrderDoc[]
  followUps FollowUpOrder[]
  /// 采购：供应商、采购额、汇率（3c）。见 TradeOrderPurchase
  purchase  TradeOrderPurchase?

  @@index([customerId])
  @@index([opportunityId])
}

/// 公海（2026-10-03，0.46.15 第 6 块，迁移 018）：有这一行 = 这位客户在公海里，谁都能领。
/// 原负责人（Customer.salesOwnerId）不清空——列表上显示「公海（原 X）」，领取时才换成领的人。
/// 只在多人时有入口（一个人用的库里公海没有意义）。自动掉公海见 lib/pool-db.ts
model CustomerPool {
  customerId String   @id
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// 谁放进去的；自动掉进去的为空。不建外键：同 AuditLog，人停用了这条照留
  userId     String?
  /// 手动 / 自动（N 天没跟进）
  reason     String   @default("手动")
  at         DateTime @default(now())
}

/// 最近一次从公海领走（2026-10-04，第 6 块复查，迁移 019）。自动掉公海从「最近跟进 / 建档 / 领取」里最晚的那个算起：
/// 不记的话，领走当天没来得及跟进，第二天又被扫回公海。一位客户一行，再领覆盖
/// 客户的外贸档案（2026-10-05，0.46.15，迁移 022）：外贸客户提的「客户加国家、WhatsApp、微信、邮箱」，
/// 再加一个「来源」——外贸模版不摆「渠道」（推荐人 / 分佣链那一套），来源就得记在客户自己身上，
/// 线索转客户时从线索带过来，直接建、Excel 导入的也有地方填。
/// 旁表不加列：Customer 是 schema 建的老表，空库从头跑迁移时它还不存在。没有这一行 = 都没填。
model CustomerExtra {
  customerId String   @id
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// 国家 / 地区，存中文名（「美国」「阿联酋」），能选也能填
  country    String?
  whatsapp   String?
  wechat     String?
  email      String?
  /// 来源：候选是业务配置里的来源那一组（外贸：阿里国际站、展会……），能选也能填
  source     String?
  /// 客户等级 A / B / C / D（2026-10-16 外贸基础，迁移 037）：只存这四个大写字母，空 = 没分级
  level      String?
  /// 官网（2026-10-16，迁移 038）：存人填的样子（可能不带 https://），点开时补协议，见 lib/customer-extra.ts 官网网址()
  website    String?
  /// 阿里国际站买家 ID（2026-10-21，迁移 040）：国际站询盘常常只有它。外贸算一种联系方式，电话 / WhatsApp / 邮箱 / 微信都没有时按它认人
  alibabaId  String?

  @@index([country])
  @@index([level])
}

model CustomerClaim {
  customerId String   @id
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// 谁领的。不建外键，同 CustomerPool
  userId     String?
  at         DateTime @default(now())
}

/// 合并重复客户留下的记号（2026-10-20，迁移 039）：被合并掉的那位（id = 它原来的客户编号）并进了哪位。
/// 不建外键：被合并的那位合并完就删了，记号得留着——中转照它拒掉「离线的那台把删掉的那份又推回来」，
/// 各台回放时引用了它的改动改挂到留下的那位（lib/sync/local.ts 回放、lib/customer-merge.ts）。
/// 范围跟着被合并的那位走（fromId）：原来管它的人那台也收得到，好把本机那份收掉
model CustomerMerge {
  id            String   @id
  /// = id。单独一列给范围同步当归属字段（主键不进范围元数据）
  fromId        String
  /// 留下的那位
  intoId        String
  /// 被合并那位原来的名字、负责人（人看的，不建外键）
  fromName      String
  fromOwnerName String?
  /// 谁合并的。不建外键，同 AuditLog
  userId        String
  at            DateTime @default(now())

  @@index([intoId])
}

/// 疑似重复里标了「不是同一个人」的两位（2026-10-20，迁移 039）：一对一行，id = 两个客户编号排好、用 __ 连起来。
/// 标了以后这一对不再列出来；同步给全队（老板和主管各台都不再列）。不建外键：哪位被删了，这一行留着也没人看
model CustomerNotDupe {
  id         String   @id
  /// 编号小的那位：范围跟着它走
  customerId String
  otherId    String
  /// 谁标的。不建外键，同 AuditLog
  userId     String
  at         DateTime @default(now())

  @@index([customerId])
  @@index([otherId])
}

/// 商机 / 订单的附件（2026-10-22 D-24，迁移 041）：合同扫描件、产品图、报价单 PDF……挂在一个商机或一张订单下（两列二选一）。
/// 文件本身在数据目录 attachments/<id>（lib/attachments.ts），这里只记名字、类型、大小、图片宽高、sha256。文件存进去以后不再改。
/// 不建外键：商机删了又撤销时编号不变，附件跟着回来；父记录没了满 1 天，本机连文件一起清掉（lib/attachments.ts 清孤儿）。
/// 这一版只存本机（不同步表）；团队版走单独的密文通道、打开时才下载，由团队同步那边接
model Attachment {
  id            String   @id @default(cuid())
  opportunityId String?
  orderId       String?
  /// 原文件名（人看的）；图片压过以后扩展名换成 .jpg
  name          String
  mime          String
  /// 字节
  size          Int
  width         Int?
  height        Int?
  sha256        String
  /// 谁传的。不建外键，同 AuditLog
  userId        String?
  createdAt     DateTime @default(now())

  @@index([opportunityId])
  @@index([orderId])
}

/// 订单的采购（2026-10-03 外贸第 3c 块，迁移 017）：从哪家采、采购额多少、按什么汇率折，毛利就出来了。
/// 旁表不加列：理由见迁移 017 开头。汇率只用在这一单的毛利上——全站合计照样不换汇。
model TradeOrderPurchase {
  orderId    String     @id
  order      TradeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplierId String?
  supplier   Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  cost       Float      @default(0)
  currency   String     @default("CNY")
  /// 1 单位订单币种 = 多少采购币种（1 USD = 7.1 CNY 就写 7.1）
  fxRate     Float?

  @@index([supplierId])
}

/// 供应商档案（2026-10-03 外贸第 3c 块，迁移 017）。贸易公司的毛利在「找对工厂」：
/// 「出过的问题」比评级有用——下次选厂前扫一眼（外贸CRM模版.md 3.2）。只在外贸模版下有入口
model Supplier {
  id        String   @id @default(cuid())
  name      String
  /// 主营品类
  category  String?
  region    String?
  contact   String?
  phone     String?
  wechat    String?
  /// 能不能开票：「能开 13% 专票」「不开票」……自由文本，比价时看口径
  invoice   String?
  /// 常用付款方式：工厂常见「30% 定金 / 货好付清」
  payment   String?
  /// A 稳定 / B 可用 / C 慎用
  rating    String?
  /// 出过的问题：延期、质量、包装错……
  issues    String?
  remark    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  quotes    SupplierQuote[]
  purchases TradeOrderPurchase[]
}

/// 比价的一行：一个商机（询盘）问一家供应商一个产品的价。同一商机同一产品、同币种同含票口径里最低价标绿（lib/supplier.ts）。
/// 结论选用 / 淘汰时理由必填——比价表上唯一给老板看的那一格
model SupplierQuote {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  supplierId    String
  supplier      Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product       String
  /// 出厂单价
  unitPrice     Float       @default(0)
  currency      String      @default("CNY")
  withInvoice   Boolean     @default(false)
  moq           Float?
  /// 交期（天）
  leadDays      Int?
  sampleFee     Float?
  validUntil    DateTime?
  quotedAt      DateTime    @default(now())
  /// 待定 / 选用 / 备选 / 淘汰
  verdict       String      @default("待定")
  reason        String?

  @@index([opportunityId])
  @@index([supplierId])
}

/// 订单的一个节点：截止日 + 状态（未开始 / 进行中 / 已完成 / 卡住 / 不适用）。名字可改。
/// 「当前节点」= 第一个既没完成也不是不适用的，算出来、不存（lib/order.ts）
model TradeOrderNode {
  id      String     @id @default(cuid())
  orderId String
  order   TradeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  idx     Int
  name    String
  dueAt   DateTime?
  status  String     @default("未开始")
  doneAt  DateTime?

  @@unique([orderId, idx])
}

/// 订单要收 / 要出的单据，三态：未收 / 已收 / 已发客户，外加「不需要」。新建时按贸易条款给默认的一组
model TradeOrderDoc {
  id      String     @id @default(cuid())
  orderId String
  order   TradeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sort    Int        @default(0)
  name    String
  state   String     @default("未收")

  @@index([orderId])
}

/// 跟进记录挂在订单的哪个节点上。不给 FollowUp 加列（schema 建的表，迁移只能加表），理由同 OpportunityMoney
model FollowUpOrder {
  followUpId String     @id
  followUp   FollowUp   @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  orderId    String
  order      TradeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  nodeIdx    Int

  @@index([orderId])
}

model FollowUp {
  id           String    @id @default(cuid())
  type         String // PHONE|MEETING|VISIT|EMAIL|SMS|TASK|REMIND|OTHER
  title        String
  content      String
  status       String    @default("已完成") // 已完成 | 待处理 | 已发送
  duration     Int? // 通话/会议时长（秒）
  occurredAt   DateTime  @default(now())
  dueAt        DateTime? // 任务截止 / 提醒时间
  dueOn        String? // 仅日期原日历日；空表示未定/明确钟点/旧未知
  dueHasTime   Boolean? // 是否明确钟点；空表示旧未知，不从午夜反推
  participants String? // 与会人，逗号分隔

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  /// 速记解析时粘贴的原始聊天记录 / 口述原文，只有 AI 起草过的记录才有
  source    FollowUpSource?
  /// 挂在订单某个节点上（2026-10-03）。见 FollowUpOrder
  orderNode FollowUpOrder?
  /// 挂在项目某个节点上（2026-10-23 项目模式 1a）。见 FollowUpProject
  projectNode FollowUpProject?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, occurredAt])
  @@index([type])
  /// 跟进记录页按发生时间倒序取最近 300 条（迁移 050）：20 万条时没有它每次都要全表排序
  @@index([occurredAt])
  /// 按成员筛跟进（迁移 050）：只有上面那条时 SQLite 没统计信息，会改成按 occurredAt 扫全表再挑人
  @@index([ownerId, occurredAt])
}

/// 跟进记录的原文。
/// 速记解析后人核对保存的是「整理后的要点」，原始对话原本用完即弃——
/// 但简报、唤醒话术要的恰恰是学员的原话与语气。单独一张表而不是加列：
/// 迁移约定只允许加表；原文体量大、只给 AI 用，也不该混进主表被列表页顺手查出来。
model FollowUpSource {
  followUpId String   @id
  followUp   FollowUp @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  text       String
  createdAt  DateTime @default(now())
}

model Task {
  id         String    @id @default(cuid())
  title      String
  dueAt      DateTime?
  dueOn      String?
  dueHasTime Boolean?
  done       Boolean   @default(false)
  doneAt     DateTime?
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ownerId    String
  owner      User      @relation(fields: [ownerId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([ownerId, done])
  @@index([customerId])
}

// 下次跟进计划（每个客户保留最新一条待执行计划）
model FollowPlan {
  id         String   @id @default(cuid())
  subject    String // 跟进主题
  plannedAt  DateTime // 计划时间
  plannedOn  String? // 仅日期原日历日，跨时区不漂移
  plannedHasTime Boolean? // 明确钟点可为00:00；空表示旧未知
  method     String   @default("电话沟通") // 跟进方式
  done       Boolean  @default(false)
  doneAt     DateTime? // 实际完成时间；旧计划未知时为空
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId, done])
}

/// 操作留痕。
///
/// 「全员可见可改」这个决策成立的前提就是有据可查：不限制谁能改，
/// 但每次改了什么、谁改的、什么时候改的都留下来，出问题能追溯。
///
/// 刻意不与 User 建外键关系，改为把姓名冗余存下来：
/// 日志只增不改不删，不该因为某个成员被删掉就丢失或被置空。
/// 也因此这张表永远不需要 ALTER，是最安全的第一张迁移表。
model AuditLog {
  id       String   @id @default(cuid())
  at       DateTime @default(now())
  /// 操作人，冗余存储，不建外键
  userId   String
  userName String
  /// 动作：create | update | delete | assign | convert | deactivate ...
  action   String
  /// 对象类型与主键，如 Customer / cmxxx
  entity   String
  entityId String?
  /// 一句话说明，直接给人看
  summary  String
  /// 结构化明细（改了哪些字段、前后值），JSON 字符串，可为空
  detail   String?

  @@index([at])
  @@index([entity, entityId])
  @@index([userId])
}

/// 系统设置（键值）。AI 接入、业务术语等在界面里改的配置都放这里，
/// 每个 key 存一段 JSON。API Key 加密后存，见 src/lib/settings.ts。
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// 首页对话的历史。**只有自己看得见**：所有读取按 ownerId 过滤。
///
/// 在这之前这串问答只活在内存里（lib/home-thread.ts），刷新即清，也开不出第二个对话。
/// 提问带的附件原文不入库，仍然只在内存里（components/AskFiles.tsx）——
/// 一旦入库，人粘进去的聊天记录就进了备份，那是另一个量级的承诺。
///
/// 不与 User 建外键：成员被删不该带走他问过的东西，也不该让删人卡在这儿。
/// 列一次留全（projectId / pinnedAt / archivedAt），因为 migrations/ 只能加表不能加列。
model AiConversation {
  id          String      @id @default(cuid())
  /// 第一问的前 18 个字，可改
  title       String
  ownerId     String
  /// 在哪一页问的：home = 首页，别的是 pathname（见 lib/home-thread.ts 的 scope）。
  /// NULL = 这一列之前落的库，不知道在哪问的；不从标题前缀倒推，见 migrations/006
  scope       String?
  /// 项目那一层先只有列，没有界面
  projectId   String?
  project     AiProject?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  pinnedAt    DateTime?
  archivedAt  DateTime?
  /// 排序按它，不按 updatedAt：重命名不该让一条老对话跳到最前面
  lastAskedAt DateTime    @default(now())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  messages    AiMessage[]

  @@index([ownerId, lastAskedAt])
  @@index([ownerId, scope, lastAskedAt])
  @@index([projectId])
}

/// 一轮问答里的一条。role = user | assistant。
model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  text           String
  model          String?
  ms             Int?
  /// 工具调用轨迹、涉及到的记录，各一段 JSON
  steps          String?
  refs           String?
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

/// 项目：一组对话 + 一段说明（会和业务简介一起注入提示词）。
/// 这一版只有表，界面下一版再长出来——列现在不留，以后就加不上了。
model AiProject {
  id            String           @id @default(cuid())
  name          String
  brief         String?
  ownerId       String
  archivedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  conversations AiConversation[]

  @@index([ownerId])
}

/// 一次导入 = 一个批次，整批可回滚。见 migrations/007 和 lib/import/。
model ImportBatch {
  id         String      @id @default(cuid())
  at         DateTime    @default(now())
  /// 谁导的。冗余存储，不建外键——成员被删不该带走导入历史
  userId     String
  userName   String
  /// 导的是哪个文件，给人认批次用。只存文件名，不存内容
  fileName   String
  /// 多工作表要支持时才用得上，眼下不填
  sheetName  String?
  created    Int         @default(0)
  updated    Int         @default(0)
  skipped    Int         @default(0)
  failed     Int         @default(0)
  /// 撤销过就有值；撤销过的批次不能再撤一次
  revertedAt DateTime?
  rows       ImportRow[]

  @@index([at])
}

model ImportRow {
  id         String      @id @default(cuid())
  batchId    String
  batch      ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  customerId String
  /// create = 这次导入建的（撤销时删掉）；update = 只补了空字段（撤销时还原那几格）
  kind       String
  /// update 时那几格原来是什么（JSON）。多是空值；备注例外——库里有备注时没对上的列添在后面，这里存原来那段
  /// （2026-10-04 L-004）。存下来是为了让撤销照着数据走，而不是照着「我记得只补空的」这条约定走
  before     String?
  /// 写完那一刻客户档案的 updatedAt。撤销时和现在的比，判断导入之后有没有人改过（迁移 010）。老批次为空，照旧按批次时刻 + 2 秒
  writtenAt  DateTime?

  @@index([batchId])
  @@index([customerId])
}

// ———— 团队版项目模式 1a（2026-10-23，迁移 042）————
// 开关在业务配置 projectMode，默认关；关着时这几张表一行都没有。只加表，现有表一列不动。
// 指向人的列都不建外键（同 TradeOrder.ownerId）：都在 src/lib/sync/tables.ts 的 指向人的列 里，改身份时一起改。
// 1a 全部不同步；1b 接团队同步时路由按 Project.ownerId + customerId，子表都挂 projectId。

/// 项目：一单生意从线索到订单就是这一行。阶段 / 节点是代码常量（src/lib/project/nodes.ts），一套不分内外贸。
model Project {
  id                   String                    @id @default(cuid())
  name                 String
  customerId           String
  customer             Customer                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// 主联系人，可空；联系人删了置空
  contactId            String?
  contact              Contact?                  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  /// 项目负责人（路由字段）。建档的人在向导里选，默认自己
  ownerId              String
  /// 实际建档的人，建好不改
  creatorId            String
  /// 线索 | 商机 | 订单
  phase                String                    @default("线索")
  /// 当前节点，见 nodes.ts
  node                 String                    @default("潜客培育")
  /// 结局：空 = 进行中；线索流失 | 丢单 | 成功交付 | 异常状态。已转商机、赢单不停在这里，直接进下一阶段第一个节点
  result               String?
  /// 异常状态选的类别（异常类别字典，必选）；恢复（再改节点）时清掉，类别留在节点变更里
  exceptionCategoryId  String?
  exceptionCategory    ProjectExceptionCategory? @relation(fields: [exceptionCategoryId], references: [id], onDelete: SetNull)
  /// 异常状态的备注，可空；恢复时清掉，备注留在节点变更里
  exceptionReason      String?
  /// 在公海里的那一刻；空 = 不在公海。在公海时 ownerId 留着放回去的人（历史负责人，他自己也能领回）
  pooledAt             DateTime?
  /// 下一步时间：在项目上记沟通时填（企业版开了超时回收时线索、商机阶段必填）。超时回收按它算、但不晚于节点时长，见 lib/project/timeout.ts；回到公海时清掉
  nextStepAt           DateTime?
  /// 尾款结清：谁勾的、何时
  balanceSettled       Boolean                   @default(false)
  balanceSettledById   String?
  balanceSettledAt     DateTime?
  /// 验收通过：谁勾的、何时。和尾款结清两项都勾上才能成功交付
  acceptancePassed     Boolean                   @default(false)
  acceptancePassedById String?
  acceptancePassedAt   DateTime?
  amount               Float                     @default(0)
  currency             String                    @default("CNY")
  remark               String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  /// 有结局的那一刻；回到进行中就清掉
  closedAt             DateTime?

  members   ProjectMember[]
  logs      ProjectNodeLog[]
  followUps FollowUpProject[]

  @@index([customerId])
  @@index([ownerId])
  @@index([pooledAt])
}

/// 项目组成员，多对多。1a 负责人直接加人写 JOINED；1b 的进组邀请用 INVITED / DECLINED 和 invitedById
model ProjectMember {
  id           String       @id @default(cuid())
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId       String
  roleId       String?
  role         ProjectRole? @relation(fields: [roleId], references: [id])
  /// INVITED | JOINED | DECLINED
  inviteStatus String       @default("JOINED")
  invitedById  String?
  createdAt    DateTime     @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

/// 组员角色字典，全队一份，只有总管理能改。删 = 停用，已用它的组员不丢。默认 4 个由代码第一次读时补上（迁移不许 INSERT）
model ProjectRole {
  id        String          @id @default(cuid())
  name      String          @unique
  sort      Int             @default(0)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  members   ProjectMember[]
}

/// 异常类别字典，全队一份，只有总管理能改（同 ProjectRole）。删 = 停用，已用它的项目不丢。默认 2 个由代码第一次读时补上
model ProjectExceptionCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  sort      Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  projects  Project[]
}

/// 节点变更：每改一次阶段 / 节点 / 结局记一行，只增不改
model ProjectNodeLog {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  at          DateTime @default(now())
  fromPhase   String?
  fromNode    String?
  fromResult  String?
  toPhase     String
  toNode      String
  toResult    String?
  /// 进异常状态时填的备注（可空）
  reason      String?
  /// 进异常状态时选的异常类别 id（ProjectExceptionCategory）；不建外键，类别只停用不删
  categoryId  String?
  /// node = 改节点；transfer = 转让负责人；pool-release = 放回公海；pool-claim = 从公海领取
  /// （后三种节点不变，from / to 节点照抄当时的；from / toOwnerId 记谁到谁）
  kind        String   @default("node")
  fromOwnerId String?
  toOwnerId   String?

  @@index([projectId, at])
}

/// 沟通记录挂项目（同 FollowUpOrder）：跟进照旧挂客户，客户时间线里照样看得到
model FollowUpProject {
  followUpId String   @id
  followUp   FollowUp @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 记这条时项目在哪个节点
  node       String

  @@index([projectId])
}

/// 客户的实际建档人（项目模式向导建客户时写）。老客户没有这一行 = 「未记录」，不猜
model CustomerCreator {
  customerId String   @id
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId     String
  at         DateTime @default(now())
}

/// 客户换负责人的记录（企业版 D-36，2026-10-24）：谁转的、从谁到谁、什么时候，只增不改。
/// 改负责人、批量分配、公海领取 / 分配、成员停用转交都记；from 是这次之前的负责人 = 「历史负责人」。
/// 指人的列都不建外键（停用的人也照样显示），靠 sync/tables.ts 的 指向人的列 改身份
model CustomerOwnerLog {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// 谁操作的
  userId      String
  at          DateTime @default(now())
  fromOwnerId String?
  toOwnerId   String?
  /// assign = 改负责人 / 批量分配；claim = 从公海领取；pool-assign = 从公海分配；deactivate = 成员停用转交
  kind        String   @default("assign")

  @@index([customerId])
}

// ───────────────────────── 企业版数据接入（2026-10-24） ─────────────────────────
// 从原系统（飞书 / 钉钉 / 它们导出的 Excel）把客户、联系人、线索、商机、跟进搬进来：
// 先试跑出报告 → 确认后正式导入 → 之后按小时 / 每晚增量同步 → 切换日关掉同步并留快照。
// 代码在 src/lib/enterprise-import/。六张表都只在本机（不进团队同步），指向人的列不建外键。

/// 一批：一次试跑、一次正式导入或一次增量同步
model EntImportBatch {
  id         String         @id @default(cuid())
  /// excel | feishu | dingtalk
  source     String
  /// full = 首次全量；sync = 增量同步；resolve = 一次冲突处理（采用原系统 / 保留我们，可整批撤回）
  kind       String         @default("full")
  /// preview = 只试跑出了报告；applying = 写到一半（可续）；done；reverting / restoring = 撤回 / 恢复到一半（可续）；reverted = 已整批撤回
  status     String         @default("preview")
  userId     String?
  /// 试跑报告 JSON（见 report.ts 的 试跑报告）
  report     String?
  /// 上传的表读出来的样子 JSON（Excel 兜底用；接口来的为空）。改映射重新试跑时从这里取，不用再传一次文件
  raw        String?
  /// 当时用的字段映射 JSON，正式导入照这份来，不重新猜
  mapping    String?
  /// 清洗后的待写记录 JSON；正式导入从这里取，保证和报告里看到的是同一份
  plan       String?
  /// 正式导入写到第几条（续写用）
  cursor     Int            @default(0)
  total      Int            @default(0)
  created    Int            @default(0)
  updated    Int            @default(0)
  skipped    Int            @default(0)
  conflicts  Int            @default(0)
  failed     Int            @default(0)
  note       String?
  createdAt  DateTime       @default(now())
  finishedAt DateTime?
  revertedAt DateTime?
  /// 最近一次整批撤回 / 恢复的账 JSON：{ 动作, 删掉, 还原, 恢复, 留下数, 留下: [{ 实体, 外部ID, 名称, 原因 }]（最多 200 条） }
  revertNote String?
  rows       EntImportRow[]

  @@index([createdAt])
}

/// 一批里写过的每一条：撤回照这里一条条退
model EntImportRow {
  id         String         @id @default(cuid())
  batchId    String
  batch      EntImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  /// customer | contact | lead | opportunity | followup
  entity     String
  externalId String
  targetId   String
  /// create | update
  kind       String
  /// update 时写之前那几格的值 JSON；create 为空
  before     String?
  /// 写完那一刻我们写进去的值 JSON（撤回时比对：不一样 = 有人改过，不撤）
  written    String
  /// 写之前的对照行 JSON（update 撤回时把 EntExternalRef 也退回去）
  refBefore  String?
  /// 整批撤回时这一行怎么处理的：空 = 还没处理；撤了；留下（导入后被动过等，原因记在批次的 revertNote）
  undo       String?
  createdAt  DateTime       @default(now())

  @@index([batchId, entity])
}

/// 原系统记录 ↔ 我们这边记录。同步按 来源 + 原系统 ID 认人
model EntExternalRef {
  id          String   @id @default(cuid())
  source      String
  entity      String
  externalId  String
  targetId    String
  /// 原系统那条记录清洗后的指纹：没变就跳过
  fingerprint String
  /// 上次我们写进去的值 JSON：同步时三方比对（原系统新值 / 我们这边现值 / 上次写的）
  written     String
  /// 原系统最后一次给的原始记录 JSON（留档；切换日快照也从这里取）
  raw         String
  batchId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([source, entity, externalId])
  @@index([entity, targetId])
}

/// 同步时发现我们这边改过、原系统也改了：不覆盖，记一笔等人定
model EntConflict {
  id           String    @id @default(cuid())
  source       String
  entity       String
  externalId   String
  targetId     String
  batchId      String?
  /// 字段 → { 原系统: 新值, 我们: 现值, 上次: 上次写的 } 的 JSON；本地已删时为 {}
  fields       String
  /// 原系统这次给的整条清洗后记录 JSON（采用原系统时照它写）
  incoming     String
  /// 本地那条已经被删了
  localDeleted Boolean   @default(false)
  /// 待定 | 采用原系统 | 保留我们 | 已撤回（那一批整批撤回了；恢复后回到待定）| 已过时（记下之后原系统又变了 / 我们这边删了或建回了，等下次同步）
  status         String    @default("待定")
  resolvedById   String?
  resolvedAt     DateTime?
  /// 定下它的那一批（kind = resolve）；撤回那一批时冲突回到待定
  resolveBatchId String?
  createdAt      DateTime  @default(now())

  @@index([status, createdAt])
  @@index([source, entity, externalId])
  @@index([resolveBatchId])
}

/// 整批撤回的「回收站」：被撤的记录连同一起建的子记录存成 JSON，能整批恢复
model EntTrash {
  id         String    @id @default(cuid())
  batchId    String
  entity     String
  targetId   String
  /// 新建的：删之前整条记录 JSON（客户带外贸档案、录入人、公海；商机带结单）；改过的：{ 还原: 改回去的那几格 }
  data       String
  /// 撤回时的对照行 JSON（恢复时照它建回 / 改回）
  ref        String?
  /// 对应哪一行 EntImportRow（恢复时照它的 kind / written 来）
  rowId      String?
  createdAt  DateTime  @default(now())
  restoredAt DateTime?

  @@index([batchId])
}

/// 切换日快照：关同步那一刻把所有对照行和原始记录存一份，留档
model EntSnapshot {
  id        String   @id @default(cuid())
  source    String
  userId    String?
  count     Int      @default(0)
  /// [{ entity, externalId, targetId, raw }] 的 JSON
  data      String
  createdAt DateTime @default(now())
}

/// 企业版组织架构（2026-10-24，迁移 044）：部门树。只在企业版（CRM_ENTERPRISE=1）读写，最多 3 层（同团队版 部门最多层数）。
/// 团队版的部门在控制库（SyncDept），桌面端靠 .team.json 拿；企业版是自托管单租户、没有控制库，所以放租户库。
model EntDept {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  sort      Int      @default(0)
  createdAt DateTime @default(now())

  @@index([parentId])
}

/// 企业版：每人在组织里的位置。没有这一行的人按 User.role 推（lib/enterprise/org.ts 的 推业务角色），不在任何部门。
/// 不建外键：同 AuditLog，人删了由应用清
model EntMember {
  userId          String   @id
  deptId          String?
  /// 业务角色，取值同团队版 lib/sync/dept-policy.ts 的 业务角色。管理员三类 = sales_mgr 销售管理 / marketing_mgr 市场管理 / director 总管理员
  bizRole         String   @default("sales")
  /// 业务线：内贸 / 外贸；null = 两边都做（线索分配用）
  line            String?
  /// 直属上级（显式指定）。空着 = 同部门、再往上级部门找销售管理（lib/enterprise/org.ts 的 直属上级of）
  managerId       String?
  /// 虚线上级：只能看，不能改、不能转
  dottedManagerId String?
  updatedAt       DateTime @updatedAt

  @@index([deptId])
  @@index([managerId])
  @@index([dottedManagerId])
}

/// 企业版线索分配（2026-10-24）：每分一次记一行。按月计数、每月清零靠 month；销售自己拓的线索没有这一行，不算数。
/// fromUserId = 分之前的负责人（通常是市场人员）：分出去以后他仍能在「我分出去的线索」里看转化情况。
/// 不建外键：同 EntMember。线索删了这几行留着当记录，「我分出去的线索」读的时候跳过
model EntLeadAssign {
  id         String   @id @default(cuid())
  leadId     String
  /// 分给谁（销售）
  toUserId   String
  /// 分之前的负责人；线索原来没人负责时为空
  fromUserId String?
  /// 谁点的分配
  byUserId   String
  /// 走哪条线：内贸 / 外贸；null = 没指定
  line       String?
  /// 营销 / 营销企划。企划线索走哪边、算不算数还没定（lib/enterprise/lead-assign.ts 的 计不计数 留口子）
  kind       String   @default("营销")
  /// 算不算进接手人当月的分配数（配额按它数）
  counted    Boolean  @default(true)
  /// YYYY-MM（业务钟：企业版北京时间），按月清零就是只数本月这一格
  month      String
  createdAt  DateTime @default(now())

  @@index([toUserId, month])
  @@index([fromUserId])
  @@index([leadId])
}

/// 企业版联系方式子表（2026-10-26，测试清单 B1 / B5 / B8，融合对照 §2 / §8.1 B1，migrations/054）。一行一个号。
/// 企业版建档向导写：选了号码类型的那个号（contactId 空）+ 联系人那一步的电话 / 邮箱 / 微信（挂 contactId）。
/// 全公司查重按 kind + numberKey 比（lib/enterprise/contact-dedupe.ts）。老号码还在 Customer.phone / Contact / CustomerExtra，
/// 这一版照写老列、查重两边都比；以后一次性回填进来再改成只读这张表（PR 说明里写了怎么迁）
model ContactMethod {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// 挂在哪位联系人上；空 = 客户本身的号（建档时选了号码类型的那个）。联系人删了号还留在客户上
  contactId    String?
  contact      Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  /// phone / email / wechat / wangwang（lib/enterprise/contact-dedupe.ts 的 号码库类型）
  kind         String
  /// 规整后存的样子（验号码 的 值：国内手机 11 位、国外 +区号…；旺旺去掉空格和符号，保留 : 子账号）
  value        String
  /// 查重比对用的规整值（验号码 的 键：手机去掉 +，邮箱 / 微信 / 旺旺小写）
  numberKey    String
  /// 格式结果：ok = 过了 验号码；以后回填老数据时验不过的记 验号码 的状态（格式错误 / 无法识别），不挡、只标
  formatStatus String   @default("ok")
  /// 归属地（手机号才有：国内按离线号段「省 市 运营商」，国外是国家名；lib/enterprise/phone-region.ts）
  region       String?
  createdAt    DateTime @default(now())

  @@index([customerId])
  @@index([contactId])
  @@index([kind, numberKey])
}

/// 企业版每人每月最多接几条分配的线索。没有这一行 = 不限。直属上级、虚线上级、总管理员、老板能设
model EntLeadQuota {
  userId    String   @id
  quota     Int
  /// 最后一次是谁设的
  setById   String
  updatedAt DateTime @updatedAt
}
