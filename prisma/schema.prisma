// CRM 客户管理系统 — 数据模型
// SQLite 用于本地开发；切换 PostgreSQL 只需改 provider 与 DATABASE_URL。
// SQLite 不支持 enum，所有枚举以 String 存储，取值常量见 src/lib/constants.ts

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  output        = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  title     String   @default("销售")
  role      String   @default("SALES") // ADMIN | MANAGER | SALES
  avatar    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads            Lead[]
  /// 作为销售负责人跟进的学员
  salesCustomers   Customer[]    @relation("SalesOwner")
  /// 作为渠道负责人吸纳的学员
  channelCustomers Customer[]    @relation("CustomerChannelOwner")
  /// 负责的外部渠道
  channels         Channel[]     @relation("ChannelOwner")
  opportunities    Opportunity[]
  followUps        FollowUp[]
  tasks            Task[]
  plans            FollowPlan[]
}

/// 托管版：控制面账号 ↔ 本工作区用户。自部署版为空表。
/// 不与 User 建外键：成员被删时这条映射由应用清理，外键会让删人这件事跨库耦合
model WorkspaceAccount {
  userId    String @id
  accountId String

  @@index([accountId])
}

model Lead {
  id          String    @id @default(cuid())
  name        String // 线索名称 / 公司名
  contact     String? // 联系人姓名
  phone       String?
  email       String?
  industry    String?
  source      String    @default("其他") // 能选也能填；候选见 lib/constants.ts 的 CUSTOMER_SOURCES（微信 / 小红书 / 抖音 / 转介绍 / 官网注册 …）
  status      String    @default("待跟进") // 待跟进 | 跟进中 | 已转化 | 已放弃
  remark      String?
  ownerId     String?
  owner       User?     @relation(fields: [ownerId], references: [id])
  convertedAt DateTime?
  customerId  String?   @unique
  customer    Customer? @relation(fields: [customerId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([ownerId])
}

/// 外部推荐渠道（如老师、中介、合作方）。链条最顶端的推荐来源。
model Channel {
  id             String  @id @default(cuid())
  name           String  @unique /// 渠道姓名，如「小红」
  phone          String?
  remark         String?
  /// 渠道负责人：内部员工，负责吸纳该渠道带来的所有客户，整条推荐链永久继承
  channelOwnerId String
  channelOwner   User    @relation("ChannelOwner", fields: [channelOwnerId], references: [id])
  active         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 由该渠道直接推荐的学员
  directCustomers Customer[] @relation("CustomerChannel")
  /// 渠道归属计算落到该渠道的学员（往上两代命中）
  attributed      Customer[] @relation("CustomerAttributionChannel")

  @@index([channelOwnerId])
}

/// 学员（潜在或已签约）
model Customer {
  id     String  @id @default(cuid())
  name   String /// 客户姓名
  phone  String /// 联系电话，查重主键
  school String? /// 院校
  grade  String? /// 年级
  major  String? /// 专业

  /// ---------- 推荐关系 ----------
  /// 链条最顶端的外部渠道。所有后代继承，用于确定渠道负责人
  channelId String?
  channel   Channel? @relation("CustomerChannel", fields: [channelId], references: [id])

  /// 直接推荐人是已有学员时指向该学员；为空且 channelId 有值表示由渠道直接推荐
  referrerCustomerId String?
  referrerCustomer   Customer?  @relation("Referral", fields: [referrerCustomerId], references: [id])
  referrals          Customer[] @relation("Referral")

  /// ---------- 渠道归属：推荐链往上第二代，不足两代取链条顶端 ----------
  /// 命中外部渠道时用这个
  attributionChannelId  String?
  attributionChannel    Channel?   @relation("CustomerAttributionChannel", fields: [attributionChannelId], references: [id])
  /// 命中已有学员时用这个
  attributionCustomerId String?
  attributionCustomer   Customer?  @relation("Attribution", fields: [attributionCustomerId], references: [id])
  attributedCustomers   Customer[] @relation("Attribution")

  /// ---------- 负责人 ----------
  /// 销售负责人：负责谈单签约
  salesOwnerId   String
  salesOwner     User    @relation("SalesOwner", fields: [salesOwnerId], references: [id])
  /// 渠道负责人：继承自 channel.channelOwner，冗余存储便于筛选统计
  channelOwnerId String?
  channelOwner   User?   @relation("CustomerChannelOwner", fields: [channelOwnerId], references: [id])

  /// ---------- 跟进与决策 ----------
  followStatus   String    @default("待跟进") /// 跟进状态
  decisionStatus String    @default("了解中") /// 客户决策状态
  expectedSignAt DateTime? /// 预计签约时间
  lastFollowAt   DateTime? /// 最近跟进
  remark         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts      Contact[]
  followUps     FollowUp[]
  tasks         Task[]
  plans         FollowPlan[]
  opportunities Opportunity[]
  contracts     Contract[]
  /// 外贸订单（2026-10-03）。见 TradeOrder
  tradeOrders   TradeOrder[]
  /// 在公海里（2026-10-03 第 6 块）。见 CustomerPool
  pool          CustomerPool?
  /// 最近一次从公海领走（第 6 块复查）。见 CustomerClaim
  claim         CustomerClaim?
  lead          Lead?

  @@index([phone])
  @@index([salesOwnerId])
  @@index([channelOwnerId])
  @@index([channelId])
  @@index([referrerCustomerId])
  @@index([followStatus])
  @@index([decisionStatus])
}

/// 签约记录。同一学员可多次签约（续费、补课），便于按月/季/年复盘
model Contract {
  id         String         @id @default(cuid())
  customerId String
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount     Int /// 签约金额，单位：元
  signedAt   DateTime /// 签约时间
  remark     String?
  /// 签约那一刻是谁的单（排查 B2）。见 ContractOwner
  owner      ContractOwner?
  /// 币种和精确金额（2026-10-03）。见 ContractMoney
  money      ContractMoney?
  /// 登记时顺手标成赢单的商机（2026-10-04 L-007）。见 ContractWin
  wins       ContractWin[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([signedAt])
}

/// 签约的币种与精确金额（2026-10-03 全站币种，迁移 014）。
/// 单独一张表、不给 Contract 加列：同 ContractOwner——Contract 只由 schema 建，迁移在空库上从头跑，加列会报表不存在。
/// Contract.amount 是 Int（元），美元的美分存不下：amountExact 存精确值，读的时候有它用它、没有退回 amount（见 lib/money-db.ts）。
/// 老签约没有这一行：人民币、按 amount。
model ContractMoney {
  contractId  String   @id
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  currency    String   @default("CNY")
  amountExact Float?
}

/// 签约那一刻的销售负责人 / 渠道负责人（2026-10-02 排查 B2，迁移 011）。
/// 业绩按它算：之后换负责人、停用同事，都不再把历史业绩搬到接手的人头上（09 月拍板「谁的数据没动，谁的归属就不变」）。
/// 单独一张表、不给 Contract 加列：Contract 是全新安装时由 schema 建的表，迁移只能加表（tests/migrations.test.ts 在空库上从头跑）。
/// 负责人不连外键：停用的人不删，名字照样查得到。0.46.15 之前的老签约没有这一行，报表退回按客户现在的负责人算。
model ContractOwner {
  contractId     String   @id
  contract       Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  salesOwnerId   String?
  channelOwnerId String?
}

model Contact {
  id         String   @id @default(cuid())
  name       String
  position   String? // 与学员的关系：母亲 / 父亲 / 学生本人 …
  phone      String?
  email      String?
  wechat     String?
  isPrimary  Boolean  @default(false) // 关键联系人
  remark     String?
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  followUps FollowUp[]

  @@index([customerId])
}

/// 从客户上移出、人留着的联系人（2026-10-01 用户反馈：在客户详情里删联系人，联系人页里也跟着没了）。
/// 单独一张表，不留在 Contact 里加个标记：Contact.customerId 不能为空、删客户会级联删联系人，
/// 留在那儿早晚被原来那位客户一起带走。id 沿用原来那条 Contact 的，挂回去时原样搬回。
model UnassignedContact {
  id               String   @id
  name             String
  position         String?
  phone            String?
  email            String?
  wechat           String?
  remark           String?
  fromCustomerId   String? // 原来是谁的。不连外键：那位之后可能被删了
  fromCustomerName String? // 原来那位的名字，给人看
  followUpIds      String? // 原来指着他的跟进记录 id（JSON 数组）。挂回原来那位时接回去
  detachedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Opportunity {
  id             String    @id @default(cuid())
  name           String
  amount         Float     @default(0)
  stage          String    @default("初步沟通") // 初步沟通|需求确认|方案报价|谈判审核|赢单成交
  status         String    @default("OPEN") // OPEN | WON | LOST
  probability    Int       @default(10)
  expectedDealAt DateTime?
  remark         String?
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ownerId        String
  owner          User      @relation(fields: [ownerId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  followUps FollowUp[]
  /// 赢单 / 丢单的那一刻（排查 C6）。见 OpportunityClose
  closed    OpportunityClose?
  /// 币种（2026-10-03）。见 OpportunityMoney
  money     OpportunityMoney?
  /// 报价明细，一次报价一行（2026-10-03）。见 Quote
  quotes    Quote[]
  /// 赢单后生成的订单（2026-10-03）。见 TradeOrder
  tradeOrders TradeOrder[]
  /// 供应商比价（2026-10-03）。见 SupplierQuote
  supplierQuotes SupplierQuote[]
  /// 是哪笔签约顺手赢下来的（2026-10-04 L-007）。见 ContractWin
  contractWin    ContractWin?

  @@index([customerId])
  @@index([stage])
}

/// 商机赢单 / 丢单的那一刻（2026-10-02 排查 C6，迁移 012）。重新打开就删掉这一行。
/// 原来「本月赢单」拿 updatedAt 近似：老的赢单改一下备注，就被算进本月。
/// 单独一张表、不给 Opportunity 加列：理由同 ContractOwner（Opportunity 是 schema 建的表，迁移只能加表）。
/// 0.46.15 之前结单的没有这一行，看板退回按 updatedAt。
model OpportunityClose {
  opportunityId String      @id
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  closedAt      DateTime    @default(now())
}

/// 登记签约时顺手标成赢单的商机，和它赢单之前的阶段 / 概率（2026-10-04 L-007，迁移 020）。
/// 原来签约和赢单之间什么都不留：删了签约，商机一直挂着赢单，本月赢单 / 漏斗 / 业绩一起虚高。
/// 删这笔签约时据此退回去；商机之后离开过赢单（人改成丢单、拖回别的阶段）就删掉这一行——人动过的不再替人退。
/// 一个商机只会被一笔签约赢下（登记时只列得出进行中的商机），所以按商机做主键：团队同步要求单列主键。
/// 单独一张表，理由同 OpportunityClose。
model ContractWin {
  opportunityId   String      @id
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  contractId      String
  contract        Contract    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  prevStage       String
  prevProbability Int

  @@index([contractId])
}

/// 商机的币种（2026-10-03 全站币种，迁移 013）。单独一张表，理由同 OpportunityClose。没有这一行 = 人民币。
model OpportunityMoney {
  opportunityId String      @id
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  currency      String      @default("CNY")
}

/// 一次报价（2026-10-03 外贸第 3 块，迁移 015）。改价不覆盖，另记一版：同一个商机的几行 Quote 就是「历次报价」，
/// 最新那一版是当前报价。币种是报价那一刻商机的币种。单独建表的理由同 OpportunityMoney。
model Quote {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  quotedAt      DateTime    @default(now())
  currency      String      @default("CNY")
  lines         QuoteLine[]

  @@index([opportunityId])
}

/// 报价的一行：产品 / 规格（自由文本，不强制建产品库）、数量、单位、单价。小计 = 数量 × 单价，不存
model QuoteLine {
  id        String  @id @default(cuid())
  quoteId   String
  quote     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  sort      Int     @default(0)
  product   String
  spec      String?
  qty       Float   @default(0)
  unit      String?
  unitPrice Float   @default(0)

  @@index([quoteId])
}

/// 外贸订单（2026-10-03 外贸第 3a 块，迁移 016）。商机管成交前（询盘 → 报价 → 客户确认），订单管成交后：
/// 12 个节点（TradeOrderNode）各有截止日 + 状态，单据清单（TradeOrderDoc），定金 / 尾款的应收实收。
/// 只在外贸模版下出现入口。业务员下单那一刻固化（ownerId，不建外键，同 ContractOwner）。
/// 表名不叫 Order：SQL 关键字。尾款应收 = amount - depositDue，不另存。
model TradeOrder {
  id            String       @id @default(cuid())
  /// 订单号 / PI 号，人能改；新建默认「年月日-序号」
  no            String
  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  ownerId       String
  amount        Float        @default(0)
  currency      String       @default("USD")
  /// 贸易条款：EXW / FOB / CFR / CIF / FCA / DAP / DDP
  incoterm      String?
  /// 付款方式：T/T 30/70、L/C at sight……自由文本
  payment       String?
  depositDue    Float        @default(0)
  depositPaid   Float        @default(0)
  depositAt     DateTime?
  balancePaid   Float        @default(0)
  balanceAt     DateTime?
  remark        String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt

  nodes     TradeOrderNode[]
  docs      TradeOrderDoc[]
  followUps FollowUpOrder[]
  /// 采购：供应商、采购额、汇率（3c）。见 TradeOrderPurchase
  purchase  TradeOrderPurchase?

  @@index([customerId])
  @@index([opportunityId])
}

/// 公海（2026-10-03，0.46.15 第 6 块，迁移 018）：有这一行 = 这位客户在公海里，谁都能领。
/// 原负责人（Customer.salesOwnerId）不清空——列表上显示「公海（原 X）」，领取时才换成领的人。
/// 只在多人时有入口（一个人用的库里公海没有意义）。自动掉公海见 lib/pool-db.ts
model CustomerPool {
  customerId String   @id
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// 谁放进去的；自动掉进去的为空。不建外键：同 AuditLog，人停用了这条照留
  userId     String?
  /// 手动 / 自动（N 天没跟进）
  reason     String   @default("手动")
  at         DateTime @default(now())
}

/// 最近一次从公海领走（2026-10-04，第 6 块复查，迁移 019）。自动掉公海从「最近跟进 / 建档 / 领取」里最晚的那个算起：
/// 不记的话，领走当天没来得及跟进，第二天又被扫回公海。一位客户一行，再领覆盖
model CustomerClaim {
  customerId String   @id
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// 谁领的。不建外键，同 CustomerPool
  userId     String?
  at         DateTime @default(now())
}

/// 订单的采购（2026-10-03 外贸第 3c 块，迁移 017）：从哪家采、采购额多少、按什么汇率折，毛利就出来了。
/// 旁表不加列：理由见迁移 017 开头。汇率只用在这一单的毛利上——全站合计照样不换汇。
model TradeOrderPurchase {
  orderId    String     @id
  order      TradeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplierId String?
  supplier   Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  cost       Float      @default(0)
  currency   String     @default("CNY")
  /// 1 单位订单币种 = 多少采购币种（1 USD = 7.1 CNY 就写 7.1）
  fxRate     Float?

  @@index([supplierId])
}

/// 供应商档案（2026-10-03 外贸第 3c 块，迁移 017）。贸易公司的毛利在「找对工厂」：
/// 「出过的问题」比评级有用——下次选厂前扫一眼（外贸CRM模版.md 3.2）。只在外贸模版下有入口
model Supplier {
  id        String   @id @default(cuid())
  name      String
  /// 主营品类
  category  String?
  region    String?
  contact   String?
  phone     String?
  wechat    String?
  /// 能不能开票：「能开 13% 专票」「不开票」……自由文本，比价时看口径
  invoice   String?
  /// 常用付款方式：工厂常见「30% 定金 / 货好付清」
  payment   String?
  /// A 稳定 / B 可用 / C 慎用
  rating    String?
  /// 出过的问题：延期、质量、包装错……
  issues    String?
  remark    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  quotes    SupplierQuote[]
  purchases TradeOrderPurchase[]
}

/// 比价的一行：一个商机（询盘）问一家供应商一个产品的价。同一商机同一产品、同币种同含票口径里最低价标绿（lib/supplier.ts）。
/// 结论选用 / 淘汰时理由必填——比价表上唯一给老板看的那一格
model SupplierQuote {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  supplierId    String
  supplier      Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product       String
  /// 出厂单价
  unitPrice     Float       @default(0)
  currency      String      @default("CNY")
  withInvoice   Boolean     @default(false)
  moq           Float?
  /// 交期（天）
  leadDays      Int?
  sampleFee     Float?
  validUntil    DateTime?
  quotedAt      DateTime    @default(now())
  /// 待定 / 选用 / 备选 / 淘汰
  verdict       String      @default("待定")
  reason        String?

  @@index([opportunityId])
  @@index([supplierId])
}

/// 订单的一个节点：截止日 + 状态（未开始 / 进行中 / 已完成 / 卡住 / 不适用）。名字可改。
/// 「当前节点」= 第一个既没完成也不是不适用的，算出来、不存（lib/order.ts）
model TradeOrderNode {
  id      String     @id @default(cuid())
  orderId String
  order   TradeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  idx     Int
  name    String
  dueAt   DateTime?
  status  String     @default("未开始")
  doneAt  DateTime?

  @@unique([orderId, idx])
}

/// 订单要收 / 要出的单据，三态：未收 / 已收 / 已发客户，外加「不需要」。新建时按贸易条款给默认的一组
model TradeOrderDoc {
  id      String     @id @default(cuid())
  orderId String
  order   TradeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sort    Int        @default(0)
  name    String
  state   String     @default("未收")

  @@index([orderId])
}

/// 跟进记录挂在订单的哪个节点上。不给 FollowUp 加列（schema 建的表，迁移只能加表），理由同 OpportunityMoney
model FollowUpOrder {
  followUpId String     @id
  followUp   FollowUp   @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  orderId    String
  order      TradeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  nodeIdx    Int

  @@index([orderId])
}

model FollowUp {
  id           String    @id @default(cuid())
  type         String // PHONE|MEETING|VISIT|EMAIL|SMS|TASK|REMIND|OTHER
  title        String
  content      String
  status       String    @default("已完成") // 已完成 | 待处理 | 已发送
  duration     Int? // 通话/会议时长（秒）
  occurredAt   DateTime  @default(now())
  dueAt        DateTime? // 任务截止 / 提醒时间
  participants String? // 与会人，逗号分隔

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  /// 速记解析时粘贴的原始聊天记录 / 口述原文，只有 AI 起草过的记录才有
  source FollowUpSource?
  /// 挂在订单某个节点上（2026-10-03）。见 FollowUpOrder
  orderNode FollowUpOrder?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, occurredAt])
  @@index([type])
}

/// 跟进记录的原文。
/// 速记解析后人核对保存的是「整理后的要点」，原始对话原本用完即弃——
/// 但简报、唤醒话术要的恰恰是学员的原话与语气。单独一张表而不是加列：
/// 迁移约定只允许加表；原文体量大、只给 AI 用，也不该混进主表被列表页顺手查出来。
model FollowUpSource {
  followUpId String   @id
  followUp   FollowUp @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  text       String
  createdAt  DateTime @default(now())
}

model Task {
  id         String    @id @default(cuid())
  title      String
  dueAt      DateTime?
  done       Boolean   @default(false)
  doneAt     DateTime?
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ownerId    String
  owner      User      @relation(fields: [ownerId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([ownerId, done])
  @@index([customerId])
}

// 下次跟进计划（每个客户保留最新一条待执行计划）
model FollowPlan {
  id         String   @id @default(cuid())
  subject    String // 跟进主题
  plannedAt  DateTime // 计划时间
  method     String   @default("电话沟通") // 跟进方式
  done       Boolean  @default(false)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId, done])
}

/// 操作留痕。
///
/// 「全员可见可改」这个决策成立的前提就是有据可查：不限制谁能改，
/// 但每次改了什么、谁改的、什么时候改的都留下来，出问题能追溯。
///
/// 刻意不与 User 建外键关系，改为把姓名冗余存下来：
/// 日志只增不改不删，不该因为某个成员被删掉就丢失或被置空。
/// 也因此这张表永远不需要 ALTER，是最安全的第一张迁移表。
model AuditLog {
  id       String   @id @default(cuid())
  at       DateTime @default(now())
  /// 操作人，冗余存储，不建外键
  userId   String
  userName String
  /// 动作：create | update | delete | assign | convert | deactivate ...
  action   String
  /// 对象类型与主键，如 Customer / cmxxx
  entity   String
  entityId String?
  /// 一句话说明，直接给人看
  summary  String
  /// 结构化明细（改了哪些字段、前后值），JSON 字符串，可为空
  detail   String?

  @@index([at])
  @@index([entity, entityId])
  @@index([userId])
}

/// 系统设置（键值）。AI 接入、业务术语等在界面里改的配置都放这里，
/// 每个 key 存一段 JSON。API Key 加密后存，见 src/lib/settings.ts。
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// 首页对话的历史。**只有自己看得见**：所有读取按 ownerId 过滤。
///
/// 在这之前这串问答只活在内存里（lib/home-thread.ts），刷新即清，也开不出第二个对话。
/// 提问带的附件原文不入库，仍然只在内存里（components/AskFiles.tsx）——
/// 一旦入库，人粘进去的聊天记录就进了备份，那是另一个量级的承诺。
///
/// 不与 User 建外键：成员被删不该带走他问过的东西，也不该让删人卡在这儿。
/// 列一次留全（projectId / pinnedAt / archivedAt），因为 migrations/ 只能加表不能加列。
model AiConversation {
  id          String      @id @default(cuid())
  /// 第一问的前 18 个字，可改
  title       String
  ownerId     String
  /// 在哪一页问的：home = 首页，别的是 pathname（见 lib/home-thread.ts 的 scope）。
  /// NULL = 这一列之前落的库，不知道在哪问的；不从标题前缀倒推，见 migrations/006
  scope       String?
  /// 项目那一层先只有列，没有界面
  projectId   String?
  project     AiProject?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  pinnedAt    DateTime?
  archivedAt  DateTime?
  /// 排序按它，不按 updatedAt：重命名不该让一条老对话跳到最前面
  lastAskedAt DateTime    @default(now())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  messages    AiMessage[]

  @@index([ownerId, lastAskedAt])
  @@index([ownerId, scope, lastAskedAt])
  @@index([projectId])
}

/// 一轮问答里的一条。role = user | assistant。
model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  text           String
  model          String?
  ms             Int?
  /// 工具调用轨迹、涉及到的记录，各一段 JSON
  steps          String?
  refs           String?
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

/// 项目：一组对话 + 一段说明（会和业务简介一起注入提示词）。
/// 这一版只有表，界面下一版再长出来——列现在不留，以后就加不上了。
model AiProject {
  id            String           @id @default(cuid())
  name          String
  brief         String?
  ownerId       String
  archivedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  conversations AiConversation[]

  @@index([ownerId])
}

/// 一次导入 = 一个批次，整批可回滚。见 migrations/007 和 lib/import/。
model ImportBatch {
  id         String      @id @default(cuid())
  at         DateTime    @default(now())
  /// 谁导的。冗余存储，不建外键——成员被删不该带走导入历史
  userId     String
  userName   String
  /// 导的是哪个文件，给人认批次用。只存文件名，不存内容
  fileName   String
  /// 多工作表要支持时才用得上，眼下不填
  sheetName  String?
  created    Int         @default(0)
  updated    Int         @default(0)
  skipped    Int         @default(0)
  failed     Int         @default(0)
  /// 撤销过就有值；撤销过的批次不能再撤一次
  revertedAt DateTime?
  rows       ImportRow[]

  @@index([at])
}

model ImportRow {
  id         String      @id @default(cuid())
  batchId    String
  batch      ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  customerId String
  /// create = 这次导入建的（撤销时删掉）；update = 只补了空字段（撤销时还原那几格）
  kind       String
  /// update 时那几格原来是什么（JSON）。按定义全是空值，存下来是为了让撤销
  /// 照着数据走，而不是照着「我记得只补空的」这条约定走
  before     String?
  /// 写完那一刻客户档案的 updatedAt。撤销时和现在的比，判断导入之后有没有人改过（迁移 010）。老批次为空，照旧按批次时刻 + 2 秒
  writtenAt  DateTime?

  @@index([batchId])
  @@index([customerId])
}
