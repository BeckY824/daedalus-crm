// 托管版的控制面数据模型。
//
// 和业务库（prisma/schema.prisma）严格分开：控制面记「谁、哪个工作区、试用到什么时候」，
// 业务库记客户和跟进。一个工作区一个业务库文件，互不可见——这是租户隔离的全部依据，
// 所以控制面绝不能存业务数据，业务库也绝不能存账号。
//
// 只有托管版（MULTI_TENANT=1）用得上。自部署的开源版整个文件不参与运行。

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  output        = "../src/generated/control"
}

datasource db {
  provider = "sqlite"
  url      = env("CONTROL_DATABASE_URL")
}

/// 一个真人。可以属于多个工作区
model Account {
  id        String   @id @default(cuid())
  /// 手机号登录为主；短信没开通时用邮箱。两者至少有一个
  phone     String?  @unique
  email     String?  @unique
  password  String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  lastLoginAt DateTime?

  memberships Membership[]
  invitesSent Invite[]     @relation("InviteCreator")
}

/// 一个团队 = 一个业务库文件
model Workspace {
  id   String @id @default(cuid())
  /// URL 与文件名都用它，全小写字母数字连字符
  slug String @unique
  name String
  /// 业务库文件名（相对于 WORKSPACE_DIR）。单独存而不是由 slug 推导，
  /// 是为了将来允许改 slug 而不必搬文件
  dbFile String @unique

  /// TRIAL | ACTIVE | EXPIRED | SUSPENDED
  status      String   @default("TRIAL")
  trialEndsAt DateTime
  /// 付费到期日；没付过就是 null
  paidUntil   DateTime?
  /// 备注：手动开通时记一句为什么，比如订单号
  note        String?

  createdAt DateTime @default(now())

  memberships Membership[]
  invites     Invite[]

  @@index([status])
}

model Membership {
  id          String   @id @default(cuid())
  accountId   String
  workspaceId String
  /// OWNER | ADMIN | MEMBER。OWNER 是创建者，不可被移除
  role        String   @default("MEMBER")
  createdAt   DateTime @default(now())

  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([accountId, workspaceId])
  @@index([workspaceId])
}

/// 注册与登录的验证码。短信与邮箱共用一张表
model VerifyCode {
  id        String   @id @default(cuid())
  /// 手机号或邮箱
  target    String
  code      String
  /// signup | login | reset
  purpose   String   @default("signup")
  expiresAt DateTime
  usedAt    DateTime?
  /// 校验失败次数，超过上限直接作废，防爆破
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([target, purpose])
}

/// 一个工作区用掉了多少次 AI 对话。
///
/// 单独一张表而不是给 Workspace 加一列：control-migrations/ 每次启动整个重跑，
/// 而 SQLite 没有 ADD COLUMN IF NOT EXISTS，加列第二次启动就会失败。
/// 和 lib/ai-quota.ts 分工不同——那个是"五分钟别刷爆"的内存限流，重启清零正合适；
/// 这个是"试用期一共送几次"，重启清零等于白送，必须落库。
model AiUsage {
  workspaceId String   @id
  calls       Int      @default(0)
  updatedAt   DateTime @default(now()) @updatedAt
}




/// 进过演示区的浏览器。
///
/// 演示区是所有访客共用一个工作区，AI 次数只能按人算，而没有账号的"人"只能用 cookie 认。
/// 原来这件事是「演示码」在做（一码一人、运营台批量生成），整套码 2026-09-15 下线之后
/// 只剩这张表：进门不再要码，但**次数仍然按浏览器记**——不记的话演示区就是
/// 一个所有人共用、不限次的账单黑洞。
///
/// 清掉 cookie 能换一份新额度，这是知道的：演示区用的是最便宜的模型、一人 5 次，
/// 为堵这个口子引入指纹或登录，代价比它防住的大。
model DemoVisitor {
  /// cookie 里那个 id
  id        String   @id
  calls     Int      @default(0)
  createdAt DateTime @default(now())
}

/// 邀请同事进工作区
model Invite {
  id          String   @id @default(cuid())
  workspaceId String
  token       String   @unique
  role        String   @default("MEMBER")
  createdById String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy Account   @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// AI 免费次数的赠送账本：注册送、每天送、运营台手动加。
///
/// 余额 = 本表之和 − AiUsage.calls。扣费仍走 AiUsage 的原子自增，这里只加不减。
/// `key` 是幂等键：同一个工作区的「注册赠送」「某一天的每日赠送」只能各有一条，
/// 两个标签页同时打开也不会送两遍——唯一索引替我们判，不用先查再插。
/// 单独一张表，规矩同上：control-migrations/ 只加不改。
model AiGrant {
  id          String   @id @default(cuid())
  workspaceId String
  amount      Int
  /// signup | daily | admin
  reason      String
  /// 幂等键，如 "ws1:signup"、"ws1:daily:2026-09-14"；运营台手动加的用随机值
  key         String   @unique
  note        String?
  createdAt   DateTime @default(now())

  @@index([workspaceId])
}

/// 按**账号**算的赠送账本。和 AiGrant 是同一套规则、不同的归属方：
/// AiGrant 记的是「这个工作区还能免费问几次」（托管版网页端），
/// 这里记的是「这个人还能免费问几次」（桌面端本地模式，数据在他自己机器上，
/// 我们只认账号）。规则实现只有一份，见 lib/tenant/credits.ts。
///
/// 分两张表而不是给 AiGrant 加一列，是因为控制面的迁移只能加表不能改表
/// （SQLite 没有 ADD COLUMN IF NOT EXISTS，而 control-migrations/ 每次启动整个重跑）。
model AccountAiGrant {
  id        String   @id @default(cuid())
  accountId String
  amount    Int
  /// signup | daily | admin
  reason    String
  /// 幂等键，如 "acc1:signup"、"acc1:daily:2026-09-14"
  key       String   @unique
  note      String?
  createdAt DateTime @default(now())

  @@index([accountId])
}

/// 一台机器的「注册赠送」被哪个账号领走了。
///
/// 免费次数原来只按账号算（幂等键是 `<accountId>:signup`），于是同一台电脑上
/// 注册第二个账号就又是一份 30 次，控制面这边没有任何机器维度的约束。
/// 这张表补上那一维：**一台机器的注册赠送只发得出去一次**，
/// 给第一个在这台机器上登录桌面端的账号。规则实现见 lib/tenant/credits.ts。
///
/// `machineHash` 是硬件 UUID（macOS 的 IOPlatformUUID、Windows 的 MachineGuid、
/// Linux 的 machine-id）**加盐 sha256** 之后的那 64 位十六进制，
/// 由 desktop/machine.js 在用户机器上算好再传上来。
/// **控制面不存任何可还原的硬件标识符**——存的只有这一串哈希。
/// 盐写在 desktop/machine.js 里，它不是秘密（防的是拿一张硬件 UUID 表来对撞，
/// 不是防我们自己）。
///
/// 这一维是客户端自报的：改得动客户端的人当然报得出一个新哈希。它防的是
/// 「同一个人在同一台电脑上顺手再注册一个账号」这种最普通的重复领取，
/// 不是有决心的对手——那种要靠支付或实名，不该由这张表来扛。
///
/// **只在真的发出注册赠送的那一刻记一条**，所以「占住一台机器」和「发出一份注册赠送」
/// 严格一对一：已经领过注册赠送的账号换台机器登录不会白占掉那台机器的名额，
/// 那台机器仍然能把它那份 30 次给别人（家里共用的那台电脑就是这个情形）。
///
/// 单独一张表，理由和上面几张一样：control-migrations/ 每次启动整个重跑，
/// 新表带 IF NOT EXISTS 天然幂等，不必押在 runner 的「列已存在就跳过」上。
model MachineSignup {
  /// 加盐 sha256 的十六进制。主键 = 一台机器一条，幂等交给唯一约束判，不先查再插
  machineHash String   @id
  /// 领走这台机器那份注册赠送的账号
  accountId   String
  createdAt   DateTime @default(now())

  @@index([accountId])
}

/// 一个账号经模型网关用掉了多少次
model AccountAiUsage {
  accountId String   @id
  calls     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt
}

/// 桌面端的登录凭证。
///
/// 桌面端的数据在用户自己机器上，它连云端只为两件事：认领账号、调模型网关。
/// 所以它拿的不是网页那种会话 cookie，而是一枚长期令牌，当作模型接口的 API Key 用——
/// 这样桌面端的 AI 配置就是标准的「接口地址 + Key」，和用户自己填 DeepSeek 的 Key
/// 走的是同一条代码路径。
///
/// 只存 sha256，不存明文：库被拖走也不能拿去调接口。
model DeviceToken {
  id         String    @id @default(cuid())
  accountId  String
  /// sha256(明文)，十六进制
  tokenHash  String    @unique
  /// 给人看的：哪台机器。列出来时用
  name       String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([accountId])
}

/// 改过密码的账号，以及改的那一刻。会话的作废线。
///
/// 会话是一张 7 天的 JWT，签出去就收不回来了——找回密码之后，
/// 拿着旧 Cookie 的人（可能正是把你挤出去的那个）还能再用 7 天，
/// 那这次「找回」就只是换了把锁，没换门。
///
/// 所以另记一条线：票据的签发时刻（`iat`）早于这条线的，一律不认。
/// 存秒而不是毫秒——`iat` 本来就只有秒，比较时严格小于，
/// 同一秒里签出来的新会话不会被自己的这条线误杀。
///
/// 单独一张表而不是给 Account 加一列，规矩同前：
/// control-migrations/ 每次启动整个重跑，而 SQLite 没有 ADD COLUMN IF NOT EXISTS。
model SessionCutoff {
  accountId String   @id
  since     DateTime
}

/// 用户从界面里发来的一句话。
///
/// 存控制面而不是业务库：反馈属于我们、不属于某个工作区，而桌面端本地模式的业务库
/// 在用户自己机器上，我们根本读不到。附带的只有定位问题必须的几样——版本、系统、
/// 当时在哪一页——**没有任何业务数据**，界面上也是这么向人承诺的。
/// 自部署的开源版不往这儿发，那边的反馈走 GitHub issues。
model Feedback {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  /// desktop | web
  source    String   @default("web")
  body      String
  /// 发的时候人在哪一页，如 /customers
  path      String?
  version   String?
  platform  String?
  /// 桌面端是云端账号 id；网页版是发的人所在工作区的成员，没有对应的 Account 就是 null
  accountId String?
  /// 给人看的一行：账号名/邮箱，或「工作区 · 成员名」
  who       String?
  /// 处理过了就打勾，运营台按它把看过的收起来
  handled   Boolean  @default(false)

  @@index([at])
}

/// 一次模型调用烧了多少 token。**按次留行，不是计数器。**
///
/// AiUsage / AccountAiUsage 那两张是单行计数器（一个 owner 一行、只有 calls），
/// 能回答「一共几次」，回答不了「这三周每天烧多少、哪个功能烧得最凶」——
/// 而定价要的是后者。所以另起一张，按次留行。
///
/// **为什么连 model 一起记**：token 换不成钱，得乘单价；而中转站会改价、我们也会换模型。
/// 只记 token 不记模型的话，改价那天之前的数据全废——回头没法重算。
///
/// 两条路分别记，不会重复：
///   桌面端  请求经我们的网关 → 网关记，owner 是**账号**
///   托管版  本进程直接打上游 → llm.ts 记，owner 是**工作区**
///   自部署  不记。那是人家自己的 key，花的不是我们的钱
///
/// 记不上不许影响请求：记录是 fire-and-forget，出错只打一行日志。
/// 这张表少一条记录无所谓，为了它让用户的提问失败才是真的错。
model AiCall {
  id           String   @id @default(cuid())
  /// account（桌面端）| workspace（托管版）
  ownerKind    String
  ownerId      String
  /// 上游实际用的模型名。单价按它查
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  /// 哪个功能烧的（ask / brief / parse…）。网关只看得见一个 OpenAI 请求，那条路是 null
  feature      String?
  at           DateTime @default(now())

  @@index([at])
  @@index([ownerKind, ownerId])
}
