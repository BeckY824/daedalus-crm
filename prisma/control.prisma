// 托管版的控制面数据模型。
//
// 和业务库（prisma/schema.prisma）严格分开：控制面记「谁、哪个工作区、试用到什么时候」，
// 业务库记客户和跟进。一个工作区一个业务库文件，互不可见——这是租户隔离的全部依据，
// 所以控制面绝不能存业务数据，业务库也绝不能存账号。
//
// 只有托管版（MULTI_TENANT=1）用得上。自部署的开源版整个文件不参与运行。

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  output        = "../src/generated/control"
}

datasource db {
  provider = "sqlite"
  url      = env("CONTROL_DATABASE_URL")
}

/// 一个真人。可以属于多个工作区
model Account {
  id        String   @id @default(cuid())
  /// 手机号登录为主；短信没开通时用邮箱。两者至少有一个
  phone     String?  @unique
  email     String?  @unique
  password  String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  lastLoginAt DateTime?

  memberships Membership[]
  invitesSent Invite[]     @relation("InviteCreator")
}

/// 一个团队 = 一个业务库文件
model Workspace {
  id   String @id @default(cuid())
  /// URL 与文件名都用它，全小写字母数字连字符
  slug String @unique
  name String
  /// 业务库文件名（相对于 WORKSPACE_DIR）。单独存而不是由 slug 推导，
  /// 是为了将来允许改 slug 而不必搬文件
  dbFile String @unique

  /// TRIAL | ACTIVE | EXPIRED | SUSPENDED
  status      String   @default("TRIAL")
  trialEndsAt DateTime
  /// 付费到期日；没付过就是 null
  paidUntil   DateTime?
  /// 备注：手动开通时记一句为什么，比如订单号
  note        String?

  createdAt DateTime @default(now())

  memberships Membership[]
  invites     Invite[]

  @@index([status])
}

model Membership {
  id          String   @id @default(cuid())
  accountId   String
  workspaceId String
  /// OWNER | ADMIN | MEMBER。OWNER 是创建者，不可被移除
  role        String   @default("MEMBER")
  createdAt   DateTime @default(now())

  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([accountId, workspaceId])
  @@index([workspaceId])
}

/// 注册与登录的验证码。短信与邮箱共用一张表
model VerifyCode {
  id        String   @id @default(cuid())
  /// 手机号或邮箱
  target    String
  code      String
  /// signup | login | reset
  purpose   String   @default("signup")
  expiresAt DateTime
  usedAt    DateTime?
  /// 校验失败次数，超过上限直接作废，防爆破
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([target, purpose])
}

/// 一个工作区用掉了多少次 AI 对话。
///
/// 单独一张表而不是给 Workspace 加一列：control-migrations/ 每次启动整个重跑，
/// 而 SQLite 没有 ADD COLUMN IF NOT EXISTS，加列第二次启动就会失败。
/// 和 lib/ai-quota.ts 分工不同——那个是"五分钟别刷爆"的内存限流，重启清零正合适；
/// 这个是"试用期一共送几次"，重启清零等于白送，必须落库。
model AiUsage {
  workspaceId String   @id
  calls       Int      @default(0)
  updatedAt   DateTime @default(now()) @updatedAt
}

/// 试用激活码：一码一个工作区。
///
/// 它替代了注册时的短信/邮件验证码——码本身就是授权凭证，拿到码的人才能开号，
/// 于是不需要任何发码通道。批量生成、一码一用、原子占用（两个人同时用同一个码只有一个能成）。
/// 单独一张表：control-migrations/ 只加不删，每次启动整个重跑。
model ActivationCode {
  /// 形如 XXXX-XXXX-XXXX，字母表去掉 0/O/1/I 这类易混字符；存归一化后的大写无横线形式
  code        String    @id
  /// 给谁的、哪一批，运营看的
  note        String?
  usedAt      DateTime?
  usedBy      String?
  workspaceId String?
  createdAt   DateTime  @default(now())

  @@index([usedAt])
}

/// 演示码：进共享演示区用，一码一人、绑定到浏览器 cookie、5 次 AI。
///
/// 和 ActivationCode（开自己工作区）性质相反：那边现在主要靠一个万能码，
/// 这边必须一码一人——演示区是所有访客共用一个工作区，AI 次数只能按人算，
/// 而"人"在没有账号的演示区里只能用 cookie 认。
model DemoCode {
  code         String    @id
  note         String?
  /// 第一次使用时绑定的访客 id（cookie 里那个），之后只认这个浏览器
  boundVisitor String?   @unique
  boundAt      DateTime?
  /// 这个码（这个人）用掉的 AI 次数
  calls        Int       @default(0)
  createdAt    DateTime  @default(now())
}

/// 万能试用码：预约演示之后发给客户的那一个，可反复开工作区，运营台一键更换。
/// 只有一行（id 固定为 "trial"）。外传了就换，旧码立刻作废。
model TrialMasterCode {
  id        String   @id @default("trial")
  code      String
  rotatedAt DateTime @default(now())
}

/// 邀请同事进工作区
model Invite {
  id          String   @id @default(cuid())
  workspaceId String
  token       String   @unique
  role        String   @default("MEMBER")
  createdById String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy Account   @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// AI 免费次数的赠送账本：注册送、每天送、邀请码送、运营台手动加。
///
/// 余额 = 本表之和 − AiUsage.calls。扣费仍走 AiUsage 的原子自增，这里只加不减。
/// `key` 是幂等键：同一个工作区的「注册赠送」「某一天的每日赠送」只能各有一条，
/// 两个标签页同时打开也不会送两遍——唯一索引替我们判，不用先查再插。
/// 单独一张表，规矩同上：control-migrations/ 只加不改。
model AiGrant {
  id          String   @id @default(cuid())
  workspaceId String
  amount      Int
  /// signup | daily | invite | admin
  reason      String
  /// 幂等键，如 "ws1:signup"、"ws1:daily:2026-09-14"；运营台手动加的用随机值
  key         String   @unique
  note        String?
  createdAt   DateTime @default(now())

  @@index([workspaceId])
}

/// 按**账号**算的赠送账本。和 AiGrant 是同一套规则、不同的归属方：
/// AiGrant 记的是「这个工作区还能免费问几次」（托管版网页端），
/// 这里记的是「这个人还能免费问几次」（桌面端本地模式，数据在他自己机器上，
/// 我们只认账号）。规则实现只有一份，见 lib/tenant/credits.ts。
///
/// 分两张表而不是给 AiGrant 加一列，是因为控制面的迁移只能加表不能改表
/// （SQLite 没有 ADD COLUMN IF NOT EXISTS，而 control-migrations/ 每次启动整个重跑）。
model AccountAiGrant {
  id        String   @id @default(cuid())
  accountId String
  amount    Int
  /// signup | daily | invite | admin
  reason    String
  /// 幂等键，如 "acc1:signup"、"acc1:daily:2026-09-14"
  key       String   @unique
  note      String?
  createdAt DateTime @default(now())

  @@index([accountId])
}

/// 一个账号经模型网关用掉了多少次
model AccountAiUsage {
  accountId String   @id
  calls     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt
}

/// 桌面端的登录凭证。
///
/// 桌面端的数据在用户自己机器上，它连云端只为两件事：认领账号、调模型网关。
/// 所以它拿的不是网页那种会话 cookie，而是一枚长期令牌，当作模型接口的 API Key 用——
/// 这样桌面端的 AI 配置就是标准的「接口地址 + Key」，和用户自己填 DeepSeek 的 Key
/// 走的是同一条代码路径。
///
/// 只存 sha256，不存明文：库被拖走也不能拿去调接口。
model DeviceToken {
  id         String    @id @default(cuid())
  accountId  String
  /// sha256(明文)，十六进制
  tokenHash  String    @unique
  /// 给人看的：哪台机器。列出来时用
  name       String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([accountId])
}
