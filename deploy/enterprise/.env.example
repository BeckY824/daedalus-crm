# 企业版部署配置。install.sh 会据此生成 .env，一般只需要改 DOMAIN 和 AI 那几行。
# 改完执行：sudo docker compose up -d

# ── 版本 ──────────────────────────────────────────────
# 升级 / 回滚请用 scripts/upgrade.sh、scripts/rollback.sh，它们会改这一行
CRM_VERSION=
# 镜像地址。离线导入镜像包时保持默认即可
#CRM_IMAGE=ghcr.io/becky824/daedalus-crm
#CADDY_IMAGE=caddy:2-alpine

# ── 访问地址 ──────────────────────────────────────────
# 访问地址：域名或服务器 IPv4 地址（只写地址，不带 https://、端口和路径）。
#   域名：先把 A 记录解析到这台服务器，并放行 80 / 443 端口，自动申请 Let's Encrypt 证书
#   IP：  没有域名时用，如 10.0.0.8。证书由 Caddy 内部 CA 签发，浏览器会提示不受信任，
#         员工电脑装一次根证书即可（scripts/export-root-cert.sh）
# 用贵司自己的证书见部署手册「四、HTTPS 证书」
DOMAIN=crm.example.com
TZ=Asia/Shanghai

# ── 账号与密钥 ────────────────────────────────────────
# 首次启动时管理员 admin 的密码。install.sh 随机生成并只显示一次；库建好后改它不起作用
INIT_PASSWORD=
# 会话密钥：留空即可，首启自动生成并存进数据卷，随备份一起带走
AUTH_SECRET=

# ── AI 接入（贵司自己的 Key）─────────────────────────
# 也可以留空，之后由管理员在「设置 → AI 接入」里填（界面里填的优先）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_MODELS=

# ── 备份 ──────────────────────────────────────────────
# 每天 03:30 自动备份到 backups/，保留最近几份
BACKUP_KEEP=30
# 再另存一份到这个目录（另一块盘 / NAS 挂载点），强烈建议配置
BACKUP_COPY_DIR=
# 备份密码文件，默认 secrets/backup.pass
#BACKUP_PASS_FILE=
