#!/usr/bin/env sh
# 推送前的自动关卡。
#
# 推送前的本地关卡。CI（.github/workflows/ci.yml）会再跑一遍并加上 E2E 与密钥扫描，
# 但等 CI 红了再改要多一个来回——这里 30 秒先把最常见的三类问题挡在本机。
#
# 启用（每台机器只需一次）：
#     git config core.hooksPath hooks
#
# 只跑快的三件，合计约 30 秒。E2E 要起 dev server、跑两分半，不进钩子——
# 维持「合并后手跑 + 部署后线上复验」。
set -e

echo "▶ 1/3 类型检查…"
npx tsc --noEmit

echo "▶ 2/3 代码检查…"
npx eslint .

echo "▶ 3/3 单元测试…"
npx vitest run

echo "✅ 预推送检查通过"
