{
  "name": "daedalus-crm",
  "version": "0.2.1",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "setup": "prisma generate && prisma db push && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:ai": "playwright test --config playwright.acceptance.config.ts",
    "test:all": "vitest run && playwright test",
    "test:e2e:prod": "E2E_PROD=1 playwright test",
    "test:coverage": "vitest run --coverage --coverage.include='src/lib/attribution.ts' --coverage.reporter=text"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@prisma/client": "6.16.2",
    "@types/bcryptjs": "^2.4.6",
    "antd": "^6.6.1",
    "bcryptjs": "^3.0.3",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "jose": "^6.2.10",
    "next": "16.3.3",
    "prisma": "6.16.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "docx": "^9.7.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
