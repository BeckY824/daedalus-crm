# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files（模板 .env.example 例外）
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
test.db

# 本地数据库与备份（测试库 test.db 已在上方忽略）
/prisma/dev.db
/prisma/dev.db-shm
/prisma/dev.db-wal
/prisma/test.db-shm
/prisma/test.db-wal
/backups/

# Prisma 生成的客户端，由 `prisma generate` 产出，不进版本库
/src/generated/

# 编辑过程中留下的备份文件
*.bak

# Playwright
/prisma/e2e.db
/prisma/e2e.db-shm
/prisma/e2e.db-wal
/test-results/
/playwright-report/
/blob-report/
test-results
playwright-report
prisma/manual.db*

# 内部资料（含服务器密码等），永远不进仓库
项目信息.md
*.内部.md

# 截图用的临时演示库
prisma/shots.db*
