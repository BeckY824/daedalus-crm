{
  "name": "daedalus-crm-desktop",
  "version": "0.46.30",
  "description": "Daedalus CRM 桌面客户端",
  "main": "main.js",
  "license": "AGPL-3.0-only",
  "scripts": {
    "start": "electron .",
    "build:server": "node scripts/build-server.mjs",
    "build:server:fast": "node scripts/build-server.mjs --no-build",
    "dist:mac": "npm run build:server && electron-builder --mac && node scripts/dmg-ulmo.mjs",
    "dist:win": "node scripts/patch-nsis-template.mjs && npm run build:server && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^25.1.8",
    "yauzl": "^2.10.0"
  },
  "build": {
    "appId": "com.daedalus.crm",
    "productName": "Daedalus CRM",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "release-version.js",
      "preload.js",
      "preload-app.js",
      "local-server.js",
      "mcp-bridge.js",
      "cloud.js",
      "glass-blur.js",
      "accounts.js",
      "machine.js",
      "updater.js",
      "update-security.js",
      "route-memory.js",
      "install.js",
      "windows-install.js",
      "delta.js",
      "backup.js",
      "auto-backup.js",
      "attachments.js",
      "crashlog.js",
      "notifications.js",
      "navigation.js",
      "windows-toast-activation.js",
      "reminders.js",
      "close-to-tray.js",
      "sync.js",
      "ops-notices.js",
      "team-notices.js",
      "feedback-replies.js",
      "sign.js",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "server-bundle",
        "to": "server"
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "identity": null
    },
    "dmg": {
      "title": "Daedalus CRM"
    },
    "win": {
      "artifactName": "Daedalus-CRM-${version}-${arch}-setup.${ext}",
      "electronLanguages": [
        "en-US",
        "zh-CN",
        "zh-TW"
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "protocols": [
        {
          "name": "Daedalus CRM notification",
          "schemes": [
            "daedalus-crm-notify"
          ]
        }
      ]
    },
    "nsis": {
      "include": "crm-installer.nsh",
      "deleteAppDataOnUninstall": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Daedalus CRM"
    },
    "afterPack": "./sign.js"
  },
  "dependencies": {
    "koffi": "^3.3.2"
  }
}
