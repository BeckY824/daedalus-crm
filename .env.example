# 复制为 .env 后按需修改。带 * 的必填。

# * 数据库文件位置。本地开发用相对路径；Docker 里由 compose 注入 /data/crm.db
DATABASE_URL="file:./prisma/dev.db"

# * 会话签名密钥，至少 32 位随机字符串。生产环境缺失或太短会拒绝启动。
#   生成：openssl rand -base64 48
AUTH_SECRET=""

# AI 功能（可选）。不配 LLM_API_KEY 时 AI 入口整体隐藏，其余功能不受影响。
# 任何 OpenAI 兼容接口都可以：
#   DeepSeek 官方  LLM_BASE_URL=https://api.deepseek.com/v1   LLM_MODEL=deepseek-chat
#   OpenAI         LLM_BASE_URL=https://api.openai.com/v1     LLM_MODEL=gpt-4o-mini
#   本地 Ollama    LLM_BASE_URL=http://localhost:11434/v1     LLM_MODEL=qwen2.5   LLM_API_KEY=ollama
LLM_API_KEY=""
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_MODEL="deepseek-chat"

# 仅 Docker：Cookie 只经 HTTPS 发送。有 http://IP 入口时必须为 false
# COOKIE_SECURE=false
# 仅 Docker + Caddy：这台机器的域名，Caddy 据此自动签证书
# DOMAIN=crm.example.com
# 仅 Docker：首次启动时 admin 账号的初始密码（至少 8 位），库已存在时忽略
# INIT_PASSWORD=
