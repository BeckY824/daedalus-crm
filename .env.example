# 全部可选。不建 .env 也能 docker compose up。

# 对外端口（默认 3000）
# PORT=3000

# 会话密钥。不传则首次启动自动生成并保存在数据卷里；要自己指定就给 ≥32 位随机串（openssl rand -base64 48）
# AUTH_SECRET=

# 首次启动时 admin 的初始密码。不传则随机生成并打印在日志里
# INIT_PASSWORD=

# AI（可选；也可以之后在「设置管理 → AI 接入」里填，界面配置优先）。任何 OpenAI 兼容接口：
#   DeepSeek 官方  https://api.deepseek.com/v1   deepseek-chat
#   OpenAI         https://api.openai.com/v1     gpt-4o-mini
#   本地 Ollama    http://localhost:11434/v1     qwen2.5   （Key 随便填）
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# 只经 HTTPS 访问时设为 true；保留 http://IP 入口时必须为 false
# COOKIE_SECURE=false
# HTTPS（配合 docker-compose.caddy.yml）：这台机器的域名
# DOMAIN=crm.example.com

# 服务器时区，默认 Asia/Shanghai
# TZ=Asia/Shanghai

# ---- 以下只在本地开发（npm run dev）时用 ----
# DATABASE_URL="file:./prisma/dev.db"
