# 全部可选。不建 .env 也能 docker compose up。

# 对外端口（默认 3000）
# PORT=3000

# 会话密钥。不传则首次启动自动生成并保存在数据卷里；要自己指定就给 ≥32 位随机串（openssl rand -base64 48）
# AUTH_SECRET=

# 首次启动时三个账号的初始密码。compose 默认 admin123（请登录后改掉）；裸 docker run 不传则随机生成打印在日志
# INIT_PASSWORD=

# AI（可选；也可以之后在「设置管理 → AI 接入」里填，界面配置优先）。任何 OpenAI 兼容接口：
#   DeepSeek 官方  https://api.deepseek.com/v1   deepseek-chat
#   OpenAI         https://api.openai.com/v1     gpt-4o-mini
#   本地 Ollama    http://localhost:11434/v1     qwen2.5   （Key 随便填）
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com/v1
# 首页模型选单（可选）。逗号分隔，用 | 加一句备注；也可以在设置页里配
# LLM_MODELS=deepseek-v4.1-flash|默认,deepseek-chat
# LLM_MODEL=deepseek-chat

# 判断类模型（可选）。导入表格时自动猜列用它——它只回「这一列是姓名还是手机号」这类
# 有固定选项的答案，不生成文字，也不占 AI 次数。不填就回落到内置的表头对照规则，导入照常能用。
# 填了之后可以在「设置 → AI 接入 → 自动判断」里随时关掉。发出去的只有表头和前三行样例值。
# JEV_API_KEY=
# 自建转发时改这里（默认 https://api.typesafe.ai）
# JEV_BASE_URL=

# 只经 HTTPS 访问时设为 true；保留 http://IP 入口时必须为 false
# COOKIE_SECURE=false
# HTTPS（配合 docker-compose.caddy.yml）：这台机器的域名
# DOMAIN=crm.example.com

# 服务器时区，默认 Asia/Shanghai
# TZ=Asia/Shanghai

# ---- 以下只在本地开发（npm run dev）时用 ----
# DATABASE_URL="file:./prisma/dev.db"
